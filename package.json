{
	"name": "tws",
	"displayName": "Trailing Whitespace",
	"description": "Highlight and remove trailing whitespaces the right way!",
	"publisher": "jkiviluoto",
	"version": "1.0.1",
	"license": "MIT",
	"engines": {
		"vscode": "^1.45.0"
	},
	"keywords": [
		"whitespace",
		"coding",
		"cleanup"
	],
	"categories": [
		"Other"
	],
	"bugs": {
		"url": "https://github.com/jannek/tws/issues",
		"email": "jkiviluoto@iki.fi"
	},
	"repository": {
		"type": "git",
		"url": "https://github.com/jannek/tws.git"
	},
	"homepage": "https://github.com/jannek/tws/blob/master/README.md",
	"activationEvents": [
		"*"
	],
	"main": "./out/extension.js",
	"contributes": {
		"commands": [
			{
				"command": "tws.trimWhiteSpace",
				"title": "Trim trailing whitespace"
			}
		],
		"configuration": {
			"title": "TWS",
			"properties": {
				"tws.trimOnSave": {
					"type": "boolean",
					"scope": "machine-overridable",
					"default": true,
					"description": "Trim trailing whitespace on save."
				},
				"tws.highlightTrailingWhiteSpace": {
					"type": "boolean",
					"scope": "machine-overridable",
					"default": false,
					"description": "Highlight trailing whitespace."
				},
				"tws.highlightOnlyChangedLines": {
					"type": "boolean",
					"scope": "machine-overridable",
					"default": false,
					"description": "Highlight trailing whitespace only on lines modified."
				},
				"tws.debugLog": {
					"type": "boolean",
					"scope": "machine-overridable",
					"default": false,
					"description": "Is the debug channel activated?"
				},
				"tws.highlightCurrentLine": {
					"type": "boolean",
					"scope": "machine-overridable",
					"default": false,
					"description": "Highlight trailing whitespace on the current line (where cursor is located)."
				},
				"tws.highlightColor": {
					"type": "string",
					"scope": "machine-overridable",
					"default": "rgba(230, 0, 0, 0.2)",
					"description": "Color for trailing whitespace highlight. Accepts any valid CSS color (hex, rgb, rgba, named colors)."
				}
			}
		}
	},
	"scripts": {
		"vscode:prepublish": "npm run compile",
		"compile": "tsc -p ./",
		"lint": "eslint src --ext ts",
		"watch": "tsc -watch -p ./",
		"pretest": "npm run compile && npm run lint",
		"test": "node ./out/test/runTest.js"
	},
	"devDependencies": {
		"@types/mocha": "^10.0.10",
		"@types/node": "^24.10.1",
		"@types/vscode": "^1.106.1",
		"@typescript-eslint/eslint-plugin": "^8.48.0",
		"@typescript-eslint/parser": "^8.48.0",
		"@vscode/test-electron": "^2.5.2",
		"eslint": "^9.39.1",
		"glob": "^13.0.0",
		"mocha": "^11.7.5",
		"typescript": "^5.9.3"
	},
	"dependencies": {
		"diff": "^8.0.3"
	}
}
